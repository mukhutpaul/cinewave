generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  EDITOR
  ADMIN
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ContentType {
  MOVIE
  SERIES
}

enum VideoProvider {
  OWN_HOSTING
  EXTERNAL
}

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  role          UserRole @default(USER)
  banned        Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions Session[]
  accounts Account[]

  @@index([role])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  movies    Movie[]
  articles  Article[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Movie {
  id             String        @id @default(cuid())
  title          String
  slug           String        @unique
  synopsis       String        @db.Text
  posterUrl      String?
  backdropUrl    String?
  releaseYear    Int?
  duration       Int?
  type           ContentType   @default(MOVIE)
  featured       Boolean       @default(false)
  status         ContentStatus @default(DRAFT)
  seoTitle       String?
  seoDescription String?
  publishedAt    DateTime?
  categoryId     String?

  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  reviews      Review[]
  videoSources VideoSource[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, featured])
  @@index([status, publishedAt])
  @@index([type, status])
  @@index([categoryId])
  @@index([createdAt])
}

model VideoSource {
  id        String        @id @default(cuid())
  movieId   String
  label     String        @default("Source vidéo")
  url       String        @db.Text
  provider  VideoProvider @default(EXTERNAL)
  isPrimary Boolean       @default(false)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@index([movieId, sortOrder])
  @@index([movieId, isPrimary])
}

model Article {
  id             String        @id @default(cuid())
  title          String
  slug           String        @unique
  excerpt        String        @db.Text
  content        String        @db.Text
  coverImageUrl  String?
  authorName     String
  status         ContentStatus @default(DRAFT)
  seoTitle       String?
  seoDescription String?
  publishedAt    DateTime?
  categoryId     String?

  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([createdAt])
}

model Review {
  id             String        @id @default(cuid())
  title          String
  slug           String        @unique
  excerpt        String        @db.Text
  content        String        @db.Text
  authorName     String
  rating         Int?
  status         ContentStatus @default(DRAFT)
  seoTitle       String?
  seoDescription String?
  movieId        String?
  publishedAt    DateTime?

  movie Movie? @relation(fields: [movieId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt])
  @@index([movieId])
  @@index([createdAt])
}
